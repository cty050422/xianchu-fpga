.workspace-scroll{flex:1;height:0;min-height:0;overflow:hidden;overscroll-behavior:contain;overflow-anchor:none}.workspace-foot{height:43rpx;min-height:43rpx;display:flex;align-items:center;justify-content:center;color:#698b85;font-size:17rpx;white-space:nowrap;overflow:hidden;flex:none}
