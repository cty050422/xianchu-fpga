.catalog-page>.card{flex:none;margin-bottom:14rpx}.catalog-summary{padding:0 2rpx 17rpx!important;margin:0 0 16rpx!important;background:transparent;border:0;border-bottom:1rpx solid #293b3f;border-radius:0}.catalog-summary>.row-item{padding:0;min-height:40rpx;border:0}.catalog-summary .caption{font-size:21rpx;color:#89a6a0}.catalog-filters{padding:18rpx!important;background:#151f24}.catalog-filters .input{height:79rpx;min-height:79rpx;background:#0f181c;font-size:25rpx;border-color:#33494a}.filter-row{margin-top:13rpx}.filter-group{display:flex;gap:9rpx;flex-wrap:wrap;margin-top:9rpx}.filter-btn{height:54rpx;min-height:54rpx;font-size:20rpx;line-height:1.3;display:flex;align-items:center;justify-content:center;margin:0;padding:9rpx 15rpx;background:#1b2a2e;border:1rpx solid #344a4b;border-radius:10rpx;color:#91aaa5}.filter-on{background:#2d493b;border-color:#76a58c;color:#d5efdc}
