/* Voice: input and composer stay anchored while conversation scrolls. */
.recorder-panel{position:relative;flex:none;padding:20rpx 23rpx 0;border:1rpx solid #436152;border-radius:26rpx;background:linear-gradient(135deg,#274434,#1a2a2a)}.voice-page .ptt-button{min-height:157rpx;margin:0;display:flex;align-items:center;justify-content:flex-start;gap:28rpx;border:0;background:transparent;color:#e4f0e5;font-size:32rpx;font-weight:500}.ptt-caption{font-size:21rpx;line-height:1.8;color:#a0beab;margin-top:7rpx;font-weight:400}.mic-symbol{position:relative;display:flex;align-items:center;justify-content:center;width:77rpx;height:87rpx;flex:none;border:1rpx solid #658b72;border-radius:23rpx;background:#304d3c}.mic-capsule{width:20rpx;height:35rpx;border:3rpx solid #c0e6cc;border-radius:12rpx;position:absolute;top:15rpx;left:25rpx}.mic-stand{position:absolute;top:26rpx;left:18rpx;width:34rpx;height:33rpx;border:3rpx solid #c0e6cc;border-top:0;border-radius:0 0 18rpx 18rpx}.mic-stand::after{content:"";position:absolute;left:13rpx;top:30rpx;height:12rpx;width:3rpx;background:#c0e6cc}.recording .mic-symbol{background:#5a3733;border-color:#b48171}.recording .mic-capsule{background:#e8b5a1;border-color:#e8b5a1}.recorder-controls{height:76rpx;display:flex;align-items:center;gap:17rpx;border-top:1rpx solid #405c4c;color:#a6c1b2;font-size:20rpx}.recorder-controls .btn{height:68rpx;min-height:68rpx;padding:0;margin:0;flex:1;justify-content:flex-start;font-size:22rpx;color:#a9cdb8}.recorder-controls switch{transform:scale(.7);transform-origin:right center;margin-left:-20rpx}.voice-status{height:72rpx;min-height:72rpx;flex:none;display:flex;align-items:center;gap:12rpx;padding:10rpx 3rpx;color:#9eb8a9;font-size:21rpx}.voice-status>text{flex:1;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;max-height:56rpx;line-height:28rpx;overflow:hidden;overflow-wrap:anywhere}.status-setting{margin:0;padding:10rpx;flex:none;border:0;border-radius:8rpx;background:#2b4335;color:#c8e8cf;font-size:19rpx;line-height:1.4}.voice-empty{padding:40rpx 8rpx 32rp