/* XianChu: one visual language, fixed chrome, independently scrolling content. */
page{height:100%;overflow:hidden;background:#0d1114;color:#f0f1ec;font:26rpx/1.55 -apple-system,"PingFang SC","Microsoft YaHei",sans-serif}
