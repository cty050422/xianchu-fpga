.safe-bottom{padding-bottom:env(safe-area-inset-bottom)}.error-text{color:#e7aca9}.empty{text-align:center;color:#8fa8a5;padding:70rpx 26rpx;font-size:24rpx;line-height:1.9}.empty-icon{display:block;font-size:45rpx;margin-bottom:19rpx;color:#91c3aa}.source-line{height:45rpx;min-height:45rpx;flex:none;display:flex;justify-content:space-between;align-items:center;gap:12rpx;font-size:17rpx;color:#89a69d;white-space:nowrap;overflow:hidden}.source-line text{max-width:53%;overflow:hidden;text-overflow:ellipsis}
