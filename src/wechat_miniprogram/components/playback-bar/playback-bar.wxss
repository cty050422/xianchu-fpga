.playback-bar{position:fixed;left:26rpx;right:26rpx;bottom:16rpx;min-height:100rpx;display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:13rpx 22rpx;background:#213b30;border:1rpx solid #66917b;border-radius:16rpx;z-index:45;box-sizing:border-box}.playback-copy{min-width:0;flex:1}.playback-title{display:block;color:#e0eddf;font-size:24rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.playback-detail{display:block;color:#9cbfa9;font-size:19rpx;line-height:1.7}.playback-bar button{margin:0;background:#355445;color:#d5ebd7;font-size:28rpx;width:70rpx;height:66rpx;padding:0;line-height:66rpx;border-radius:12rpx}.playback-bar button::after{border:0}