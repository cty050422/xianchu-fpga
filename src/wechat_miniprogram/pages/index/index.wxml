<view class="page instrument-page">
  <view class="app-header"><view class="wordmark"><view class="brand-en">表情合成乐器</view><view class="app-title">弦触<text class="title-dot">·</text>云声</view></view><view class="connection-state {{connected ? 'online' : ''}}"><view class="state-dot"></view><text>{{connected ? '已连接' : '未连接'}}</text></view></view>
  <view class="view-tabs" role="tablist" aria-label="乐器工作区"><button class="view-tab {{activeView === 'perform' ? 'selected' : ''}}" data-view="perform" bindtap="switchView" aria-selected="{{activeView === 'perform'}}">演奏</button><button class="view-tab {{activeView === 'songs' ? 'selected' : ''}}" data-view="songs" bindtap="switchView" aria-selected="{{activeView === 'songs'}}">预置曲</button><button class="view-tab {{activeView === 'device' ? 'selected' : ''}}" data-view="device" bindtap="switchView" aria-selected="{{activeView === 'device'}}">连接</button></view>
  <view class="message-slot {{lastError ? 'has-error' : ''}}" bindtap="showMessage" role="status"><text class="message-icon">{{lastError ? '!' : '·'}}</text><text class="message-text">{{lastError ? '操作未确认，点此查看' : auditionActive ? 'FPGA 合成演奏中' : connected ? (stateFresh ? '乐器在线' : '乐器状态失鲜') : '未连接乐器'}}</text><text class="message-more">查看</text></view>
  <view class="panel-area">
    <view class="perform-panel performance-workspace" wx:if="{{activeView === 'perform'}}">
      <view class="performance-modes"><button class="{{performanceMode === 0 ? 'chosen' : ''}}" data-mode="0" bindtap="chooseMode" disabled="{{!connected || busy || auditionActive}}">自由</button><button class="{{performanceMode === 1 ? 'chosen' : ''}}" data-mode="1" bindtap="chooseMode" disabled="{{!connected || busy || auditionActive}}">引导</button><button class="{{performanceMode === 2 ? 'chosen' : ''}}" data-mode="2" bindtap="chooseMode" disabled="{{!connected || busy || auditionActive}}">挑战</button></view>
      <view class="score-heading"><text class="score-title">{{songLoaded ? currentSongName : '未选曲'}}</text><text>{{groupLabel}} · {{octaveLabel}} · {{transportLabel}}</text></view>
      <view class="performance-target"><view><text class="target-caption">{{guideActive ? '当前目标' : performanceMode === 0 ? '自由演奏' : '练习待机'}}</text><text class="current-target {{targetLabel.length > 1 ? 'target-chord' : ''}}">{{guideActive ? targetLabel : '—'}}</text></view><text class="target-action">{{guideActive ? expressionText : performanceMode === 0 ? '按压力键开始演奏' : songLoaded ? '按开始进入练习' : '先从曲库下载练习谱'}}</text></view>
      <view class="live-pads"><view wx:for="{{guideZones}}" wx:key="index" class="live-pad {{heldActive[item.index] ? 'pressed' : ''}} {{guideActive && targetActive[item.index] ? 'target' : ''}}"><text>{{item.index + 1}}</text><text class="zone-note">{{zoneNotes[item.index]}}</text><view class="pad-light"></view></view></view>
      <view class="voice-rows {{voicesStale ? 'voices-stale' : ''}}" aria-label="各声部实际音色与分量"><view wx:for="{{voiceRows}}" wx:key="index" class="voice-row {{item.active ? 'on' : ''}}"><text class="voice-id">声部{{index + 1}} · 区{{item.region}}</text><text class="voice-note">{{item.note}}</text><text>{{item.tone}}</text><text class="numeric">{{item.partials}} 分量</text><view class="voice-level"><view style="width:{{item.levelPercent}}%"></view></view></view></view>
      <view class="live-expression"><view class="{{glideActive ? 'expression-on' : ''}}"><text>滑音</text><text>{{glideText}}</text></view><view class="{{vibratoActive ? 'expression-on' : ''}}"><text>颤音</text><text>{{vibratoText}}</text></view></view>
      <view class="mobile-wave {{waveFresh ? '' : 'wave-stale'}}"><view class="wave-caption"><text>{{waveLabel}}</text><text>FPGA</text></view><canvas canvas-id="pcmWave" id="pcmWave" class="pcm-canvas" style="width:300px;height:70px" width="300" height="70"></canvas></view>
      <view class="result-row"><text>命中 <text class="numeric">{{hits}}</text></text><text>错按 <text class="numeric">{{wrong}}</text></text><text>漏拍 <text class="numeric">{{misses}}</text></text><text class="result-note">{{performanceMode === 2 ? '按区 / 节拍' : '设备实况'}}</text></view>
      <view class="sound-selectors"><picker range="{{presetNames}}" bindchange="selectPreset" disabled="{{!connected || busy}}"><text>{{presetLabel}} ▾</text></picker><picker range="{{effectNames}}" bindchange="selectEffect" disabled="{{!connected || busy}}"><text>{{effectLabel}} ▾</text></picker></view>
      <view class="j2-summary">{{j2Text || 'J2 · 分量 / 效果湿度'}}</view>
    </view>
    <view class="song-panel" wx:if="{{activeView === 'songs'}}">
      <view class="panel-title"><view><view class="section-heading">预置曲</view></view><text class="count-badge">{{songNames.length}} 首</text></view>
      <view class="panel-description">下载后可在设备上练习。</view>
      <scroll-view class="song-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}"><view wx:for="{{songNames}}" wx:key="*this" class="song-item {{selectedSong === index ? 'chosen' : ''}}" data-index="{{index}}" bindtap="chooseSong"><text class="song-index">0{{index + 1}}</text><view class="song-copy"><text class="song-name">{{item}}</text><text class="song-subtitle">四区指引 · 本地预置曲</text></view><text class="song-check">{{selectedSong === index ? '●' : '○'}}</text></view></scroll-view>
      <view class="transfer-box"><view class="transfer-heading"><text>曲谱传输</text><text class="transfer-text">{{uploadProgress || (selectionCommitted ? '所选曲目已提交' : songLoaded ? '设备保留曲目 ' + currentSong : '尚未下载')}}</text></view><progress percent="{{uploadPercent}}" stroke-width="3" border-radius="3" activeColor="#c5dfa5" backgroundColor="#343d2e" duration="120"></progress><text class="transfer-note">曲谱v2每段最多64步；复位后重新下载。</text></view>
      <button class="action-primary download-button" disabled="{{!connected || busy}}" loading="{{busy}}" bindtap="downloadSong">{{busy ? '正在传输，请稍候' : '下载所选曲目'}}<text class="button-arrow">↗</text></button>
    </view>
    <view class="device-panel" wx:if="{{activeView === 'device'}}">
      <view class="panel-title"><view><view class="section-heading">设备连接</view></view><text class="count-badge">蓝牙</text></view>
      <view class="connection-card"><view class="device-name">{{connected ? deviceName : 'XianChu 桥接器'}}</view><view class="device-state-line"><text>{{connected ? linkMode : '等待蓝牙连接'}}</text><text>{{armedText}}</text></view><button class="action-primary" loading="{{scanning}}" disabled="{{connected || scanning}}" bindtap="connect">{{scanning ? '正在查找桥接器' : connected ? '桥接器已连接' : '扫描并连接'}}<text class="button-arrow">↗</text></button><view class="pair-actions"><button class="action-secondary" disabled="{{!phoneArmAvailable || !connected || busy}}" bindtap="armPhone">配对并授权</button><button class="action-secondary" disabled="{{!connected || busy}}" bindtap="ping">验证 FPGA PING</button></view></view>
      <scroll-view class="diagnostic-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="data-heading disclosure-row" bindtap="onToggleJoystickDirections" role="button" aria-expanded="{{joystickDirectionsOpen}}"><text>摇杆方向</text><text>{{joystickDirectionsOpen ? '收起' : '展开'}}</text></view>
        <block wx:if="{{joystickDirectionsOpen}}"><view class="data-row axis-legend" wx:for="{{axisLegends}}" wx:key="label"><text>{{item.label}}</text><text class="data-value">{{item.value}}</text></view></block>
        <view class="data-row"><text>校准</text><text class="data-value">{{calibrated ? '已校准' : '待校准'}}</text></view><view class="data-row"><text>曲谱</text><text class="data-value">{{songLoaded ? '已载入' : '未载入'}}</text></view>
        <view class="data-heading disclosure-row" bindtap="onToggleConnectionDetails">连接详情<text>{{connectionDetailsOpen ? '收起 −' : '展开 +'}}</text></view>
        <block wx:if="{{connectionDetailsOpen}}"><view class="data-row"><text>固件</text><text class="data-value">{{identityBuild}}</text></view><view class="data-row"><text>认证</text><text class="data-value">{{authenticatedText}}</text></view><view class="data-row"><text>协议</text><text class="data-value">{{protocolText}}</text></view><view class="data-row"><text>声部帧 / 波形窗</text><text class="data-value numeric">{{voiceFrameCount}} / {{waveWindowCount}}</text></view><view class="data-row"><text>有效状态帧</text><text class="data-value numeric">{{statusFrameCount}}</text></view><view class="data-row"><text>事件 / 分片</text><text class="data-value numeric">{{bleEventCount}} / {{statusPacketCount}}</text></view><view class="data-row"><text>接收字节</text><text class="data-value numeric">{{statusByteCount}}</text></view><view class="data-row"><text>最近命令</text><text class="data-value">{{lastStatusCommand}} · {{lastStatusResult}}</text></view><view class="compatibility-note">{{phoneArmAvailable ? '配对授权后检查设备连接。' : '此固件需先在电脑串口发送 ARM。'}}</view><view class="compatibility-note">校准：释放压力区、摇杆回中，按住 Z2 后点按 KEY2，约 1 秒后松开。</view></block>
        <view class="pair-actions"><button class="text-button" disabled="{{!connected || busy}}" bindtap="disarmPhone">撤销授权</button><button class="text-button" disabled="{{!connected}}" bindtap="disconnect">断开设备</button></view>
      </scroll-view>
    </view>
  </view>
  <view class="bottom-dock" wx:if="{{!auditionActive}}"><view class="dock-caption"><text class="dock-status">{{modeLabel}}</text><text class="dock-detail">{{transportLabel}}</text></view><view class="dock-actions"><button class="stop-button" disabled="{{!connected || busy}}" bindtap="stopPractice" aria-label="停止练习">■</button><button class="play-button" disabled="{{!connected || !stateFresh || busy || !calibrated || panicMute || testMode}}" bindtap="runPractice">{{performanceMode === 0 ? '直接演奏' : practiceTransport === 2 ? '暂停' : practiceTransport === 3 ? '继续' : '开始'}}<text>{{practiceTransport === 2 ? 'Ⅱ' : '▶'}}</text></button></view></view>
  <playback-bar></playback-bar>
</view>
