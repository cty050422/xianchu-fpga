.voice-row{flex:1;min-width:0;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:2rpx;border:1rpx solid #293c40;border-radius:12rpx;color:#708087;font-size:19rpx;white-space:nowrap}
.voice-row.on{color:#99e5ca;border-color:#496b61}.voice-note{font-size:30rpx;line-height:32rpx;color:#e5e9df}.voice-id{font-size:17rpx}.voices-stale{opacity:.35}.voice-row .numeric{font-variant-numeric:tabular-nums}
.zone-note{font-size:19rpx;line-height:1.2;color:#c4dccd;font-variant-numeric:tabular-nums}.voice-level{width:70%;height:4rpx;min-height:4rpx;background:#263b34;border-radius:3rpx;overflow:hidden}.voice-level>view{height:100%;background:#9ddbb9}.performance-workspace .current-target.target-chord{font-size:45rpx;letter-spacing:-1rpx;white-space:nowrap}
